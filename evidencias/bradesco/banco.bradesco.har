            "text": "html.accessib-contraste-pa body,\nhtml.accessib-contraste-pb body,\nhtml.accessib-contraste-pa .mega-menu-produtos,\nhtml.accessib-contraste-pb .mega-menu-produtos,\nhtml.accessib-contraste-pa .mega-menu-canais,\nhtml.accessib-contraste-pb .mega-menu-canais,\nhtml.accessib-contraste-pa .online-hire .non-account-holder,\nhtml.accessib-contraste-pb .online-hire .non-account-holder,\nhtml.accessib-contraste-pa .mainHeader button#textobusca,\nhtml.accessib-contraste-pb .mainHeader button#textobusca,\nhtml.accessib-contraste-pa .mainHeader ul.navSeg li div.navCnt ul.nav > li a:hover,\nhtml.accessib-contraste-pb .mainHeader ul.navSeg li div.navCnt ul.nav > li a:hover,\nhtml.accessib-contraste-pa .float-abra-conta-link,\nhtml.accessib-contraste-pb .float-abra-conta-link {\n    background-color: #000!important;\n    box-shadow: none!important;\n}\n\nhtml.accessib-contraste-pa *,\nhtml.accessib-contraste-pa .online-hire .non-account-holder,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa,\nhtml.accessib-contraste-pa .menulist-produtos:before {\n    color: #ff0 !important;\n    box-shadow: none!important;\n}\n\nhtml.accessib-contraste-pa .online-hire .cards .card .card-link,\nhtml.accessib-contraste-pa .benefits-section .benefits-list .benefit-card {\n    background: #000!important;\n    border: 1px solid #ff0!important;\n    border-radius: 7px!important;\n    color: #ff0!important;\n    filter: unset!important;\n}\n\nhtml.accessib-contraste-pb .online-hire .cards .card .card-link,\nhtml.accessib-contraste-pb .benefits-section .benefits-list .benefit-card,\nhtml.accessib-contraste-pb {\n    background: #000!important;\n    border: 1px solid #fff!important;\n    border-radius: 7px!important;\n}\n\nhtml.accessib-contraste-pa .como-usar-after,\nhtml.accessib-contraste-pb .como-usar-after,\nhtml.accessib-con