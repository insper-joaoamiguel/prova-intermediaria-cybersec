l para mobile -->\n  <script src=\"/assets/classic/home/js/util/jquery-3.6.0.min.js\"></script>\n  <script src=\"/assets/common/js/purify.js\" defer></script>\n  <script src=\"/assets/common/js/slick.min.js\" defer></script>\n  <script src=\"/assets/classic/js/banner/jquery.flexslider.js\" defer></script>\n  <script src=\"/assets/common/js/jquery.magnific-popup.min.js\" defer></script>\n  <script src=\"/assets/classic/home/js/util/util.js\" defer></script>\n  <script src=\"/assets/classic/home/js/header.js\" defer></script>\n  <script src=\"/assets/classic/home/js/segments.js\" defer></script>\n  <script src=\"/assets/classic/home/js/banner.js\" defer></script>\n  <script src=\"/assets/classic/home/js/destaques.js\" defer></script>\n  <script src=\"/assets/classic/home/js/mega-menu.js?refresh=022024\" defer></script>\n  <script src=\"/assets/classic/home/js/tagueamento.js\" defer></script>\n  <script src=\"/assets/classic/home/js/progress-bar.js\" defer></script>\n  <script src=\"/assets/classic/home/js/bannerCustomization.js\" defer></script>\n  <script src=\"/assets/common/js/bmak.js\" defer></script>\n  <script src=\"/assets/common/js/valida_agenciaconta.js?nc=20210920\" defer></script>\n  <script src=\"/static/wcomp/header-footer-v2/main.min.js?type=classic\"></script>\n  <script src=\"/assets/classic/home/js/scripts.js\" defer></script>\n  <script type=\"text/javascript\">\n    function getRandom() {\n      var a = new Uint32Array(1);\n      window.crypto.getRandomValues(a);\n      return a[0] / 4294967296;\n    }\n\n    (function (d, f) { var b = { src: (d.location.protocol == \"https:\" ? \"https:\" : \"http:\") + \"//d3flklo0seol33.cloudfront.net/6029901/mdmnRnd.js?r=\" + getRandom(), async: true, type: \"text/javascript\" }, c = f.createElement(\"script\"), h = f.getElementsByTagName(\"head\")[0]; setTimeout(function () { for (var e in b) { c.setAttribute(e, b[e]) } h.appendChild(c) }, 0) })(window, document);\n  </script>\n\n  \n  <!-- Bia Mobile -->\n  <style>\n    #bia-container .container {\n        background: none !important;\n        height: 0 !important;\n        width: 0 !important;\n    }\n</style>\n\n<div id=\"bia-container\"></div>\n\n<script>\n    const AEM_BASE = \"https://publish-p128342-e1259725.adobeaemcloud.com\";\n    const XF_URL = AEM_BASE + \"/experience-fragments/portal_bradesco/componentes/bia/master.html\";\n    const ROUTE_BLOCKS_URL = \"/assets/common/chatbia/inc/chatbia-route-blocks.json\";\n\n    let routeBlocks = [];\n\n    async function loadRouteBlocks() {\n        try {\n            const resp = await fetch(ROUTE_BLOCKS_URL);\n            if (!resp.ok) throw new Error(\"Erro ao carregar JSON\");\n            const data = await resp.json();\n            routeBlocks = data.routeBlocks || [];\n            console.log(\"[BIA] routeBlocks carregado:\", routeBlocks);\n        } catch (err) {\n            console.warn(\"[BIA] Não foi possível carregar routeBlocks, seguindo sem bloqueio\", err);\n            routeBlocks = [];\n        }\n    }\n\n    function isRouteBlocked() {\n        const currentPath = window.location.pathname.replace(/^\\/+/, \"\");\n        return routeBlocks.includes(currentPath);\n    }\n\n    function fixRelative(el, attr) {\n        const val = el.getAttribute(attr);\n        if (!val) return;\n\n        if (val.startsWith(\"http\") || val.startsWith(\"//\") || val.startsWith(\"data:\")) return;\n\n        if (val.startsWith(\"/\")) el.setAttribute(attr, AEM_BASE + val);\n        else el.setAttribute(attr, AEM_BASE + \"/\" + val);\n    }\n\n    async function loadBIA() {\n        await loadRouteBlocks();\n\n        if (isRouteBlocked()) {\n            console.warn(\"[BIA] Componente bloqueado pela rota atual.\");\n            return;\n        }\n\n        const container = document.getElementById(\"bia-container\");\n\n        const html = await fetch(XF_URL).then(r => r.text());\n\n        const doc = new DOMParser().parseFromString(html, \"text/html\");\n\n        doc.querySelectorAll(\"[src]\").forEach(el => fixRelative(el, \"src\"));\n        doc.querySelectorAll(\"[href]\").forEach(el => fixRelative(el, \"href\"));\n\n        doc.querySelectorAll(\"link[rel='stylesheet']\").forEach(link => {\n            const newLink = document.createElement(\"link\");\n            [...link.attributes].forEach(a => newLink.setAttribute(a.name, a.value));\n            document.head.appendChild(newLink);\n        });\n\n        container.innerHTML = doc.body.innerHTML;\n\n        container.querySelectorAll(\"script\").forEach(oldScript => {\n            const newScript = document.createElement(\"script\");\n            [...oldScript.attributes].forEach(a => newScript.setAttribute(a.name, a.value));\n            newScript.textContent = oldScript.textContent;\n            oldScript.replaceWith(newScript);\n        });\n\n        console.log(\"[BIA] Componente carregado com sucesso.\");\n    }\n\n    document.addEventListener(\"DOMContentLoaded\", loadBIA);\n</script> \n\n  <!-- Bia Desktop com QR code -->\n  \n\n  <script type=\"text/javascript\" src=\"/static/carrossel-banners/carrossel.js\"></script>\n  <script src=\"/assets/common/js/rybena-mobile.js\"></script>\n<script type=\"text/javascript\"  src=\"/xEIFL89ffXwo5/ZoHpebBbaN/aDcw/EYDhfSmQfYQNDVSY3E/ByIdCwE/bkYo/akNOR0c\"></script><noscript><img src=\"https://banco.bradesco/akam/13/pixel_4edbb210?a=dD1lNDMwNjcwOWU5NDM0MzIxNDEwYzIwNDc5Y2YwOWExNmJmNjVjMDJkJmpzPW9mZg==\" style=\"visibility: hidden; position: absolute; left: -999px; top: -999px;\" /></noscript></body>\n\n</html>"
