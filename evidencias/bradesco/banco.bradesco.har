          "content": {
            "mimeType": "text/html; charset=utf-8",
            "size": 14987,
            "text": "<!DOCTYPE html>\n<html lang=\"PT-BR\">\n\n<link rel=\"stylesheet\" type=\"text/css\" href=\"/assets/common/css/intervencao-neb.css\">\n\n<!-- modal -->\n<div class=\"modal__bg-alfa-ie\" id=\"intervencao-NEB\">\n  <img class=\"logo-intervencao-ie carregarLogo\" src=\"\" alt=\"\">\n\n  <div class=\"modal__container-infor-ie\">\n    <div class=\"modal__conteudo\">\n      <img src=\"https://assets.bradesco/content/dam/portal-bradesco/assets/common/img/bra-logo.png\" alt=\"\"><br><br>\n      <p class=\"modal__conteudo--texto\">\n        <strong>Para a conta da sua empresa, acesse o Bradesco Net Empresa</strong>\n      </p>\n      <a href=\"/html/pessoajuridica/net-empresa/index.shtm\" class=\"btn__ok\" onclick=\"dispararDatalayer()\">Acessar conta</a>\n      <br><br><br>\n      <p>Se você for pessoa física, use um dos navegadores pra poder acessar:</p>\n\n      <div class=\"container-modal\">\n          <div>\n            <img src=\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/img/nav-chrome.svg\" alt=\"\">\n            <p class=\"link-texto\"><small>Google Chrome</small></p>\n          </div>\n\n          <div>\n            <img src=\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/img/nav-edge.svg\" alt=\"\">\n            <p class=\"link-texto\"><small>Microsoft Edge</small></p>\n          </div>\n\n          <div>\n            <img src=\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/img/nav-firefox.svg\" alt=\"\">\n            <p class=\"link-texto\"><small>Firefox</small></p>\n          </div>\n      </div>\n    </div>\n\n  </div>\n\n</div>\n<script>\n  const versions = ['Mozilla/5.0 (Linux; Android 6.0; Nexus 5 Build/MRA58N) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Mobile Safari/537.36 Edg/132.0.0.0','NetExpress(3.0.0) Firefox/3.0.0 Mozilla/rv.29.0 W', 'NetExpress(3.0.1) Firefox/3.0.1 Mozilla/rv.29.0 W', 'NetExpress(3.0.2) Firefox/3.0.1 Mozilla/rv.29.0 W','NetExpress(3.0.3) Firefox/3.0.0 Mozilla/rv.29.0 W', 'NetExpress Addon(4.0.0) Firefox/4.0.0 Mozilla/rv.50.1.0 W','NetExpress Addon(4.0.1) Firefox/4.0.1 Mozilla/rv.50.1.0 W','NetExpress Addon(4.0.2) Firefox/4.0.2 Mozilla/rv.50.1.0 W','NetExpress Addon(4.0.3) Firefox/4.0.3 Mozilla/rv.50.1.0 W','NetExpress Addon(4.0.4) Firefox/4.0.4 Mozilla/rv.50.1.0 W', \"NetExpress Addon(4.0.5) Firefox/4.0.5 Mozilla/rv.50.1.0 W\",\"NetExpress Addon(4.0.6) Firefox/4.0.6 Mozilla/rv.50.1.0 W\",\"NetExpress Addon(4.0.7) Firefox/4.0.7 Mozilla/rv.50.1.0 W\",\"NetExpress Addon(4.0.8) Firefox/4.0.8 Mozilla/rv.50.1.0 W\",\"NetExpress Addon(4.0.9) Firefox/4.0.9 Mozilla/rv.50.1.0 W\",\"NetExpress Addon(4.1.0) Firefox/4.1.0 Mozilla/rv.50.1.0 W\", 'NetExpress WebExtension (5.0.0) Firefox/4.0.0 Mozilla/rv.67.1.0 W']\n  const url = document.location.pathname;\n\n  document.addEventListener('DOMContentLoaded', function () {\n    if (versions.includes(navigator.userAgent) || document.location.href.includes('navneb')) {\n      $('#intervencao-NEB').css(\"display\", \"block\");\n      $('#cookies').css(\"display\", \"none\");\n    \n      var navSeg = document.querySelector('.navSeg');\n      if (document.location.href.includes('navneb') && (url.includes('corporate') || url.includes('pessoajuridica'))){\n        function removeClassToSubsItems() {\n          const combopf = navSeg.getElementsByClassName(\"divisor\");\n          combopf[0].style.display = 'none'\n        }\n        removeClassToSubsItems()\n      }\n    }\n  })\n\n  function dispararDatalayer() {\n    const path = window.location.pathname;\n    let segmento = 'indefinido';\n \n    if (path.includes('/html/classic/')) {\n      segmento = 'classic';\n    } else if (path.includes('/html/exclusive/')) {\n      segmento = 'exclusive';\n    } else if (path.includes('/html/prime/')) {\n      segmento = 'prime';\n    }\n \n    dataLayer.push({\n        event: 'Event_Data',\n        event_type: 'new',\n        ga_event:{\n          location: 'acesse-o-bradesco-net-empresa',\n          action: 'modal',\n          element_name: 'modal_acessar-conta' \n        },\n        product:{\n          product: 'portal-bradesco_' + segmento,\n              flow: 'home'\n        },\n          user:{\n              user_id: '', \n              segment: '', \n              logged_user: 'deslogado', \n              ownership: ''\n          },   \n      });\n  }\n\n</script>\n\n<head>\n  <!-- Google Tag Manager -->\n  <script async>\n    (function (w, d, s, l, i) {\n      w[l] = w[l] || [];\n      w[l].push({ \"gtm.start\": new Date().getTime(), event: \"gtm.js\" });\n      var f = d.getElementsByTagName(s)[0],\n        j = d.createElement(s),\n        dl = l != \"dataLayer\" ? \"&l=\" + l : \"\";\n      j.async = true;\n      j.src = \"https://www.googletagmanager.com/gtm.js?id=\" + i + dl;\n      f.parentNode.insertBefore(j, f);\n    })(window, document, \"script\", \"dataLayer\", \"GTM-T9F3WZN\");\n  </script>\n  <!-- End Google Tag Manager -->\n  <meta charset=\"UTF-8\">\n  <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Banco Bradesco | Você primeiro</title>\n  <meta name=\"description\" content=\"Conheça as facilidades do Bradesco para fazer a gestão do seu dinheiro! Confira saldos, extratos, empréstimos, solicite seu cartão, consórcio e muito mais!\">\n  <link rel=\"shortcut icon\" href=\"/assets/classic/home/images/favicon.ico\">\n\n  <!-- Metatags Facebook -->\n  <meta property=\"og:type\" content=\"website\" />\n  <meta property=\"og:title\" content=\"Banco Bradesco | Você primeiro\" />\n  <meta property=\"og:description\"\n      content=\"Conheça as facilidades do Bradesco para fazer a gestão do seu dinheiro! Confira saldos, extratos, empréstimos, solicite seu cartão, consórcio e muito mais!\" />\n  <meta property=\"og:url\" content=\"banco.bradesco\" />\n  <meta property=\"og:image\" content=\"https://banco.bradesco/assets/classi