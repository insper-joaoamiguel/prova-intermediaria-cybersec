            "text": ".modal-busca {\n  height: auto;\n  z-index: 999999;\n  position: absolute;\n  left: 0;\n  right: 0;\n  box-shadow: inset 0px 3px 6px rgba(0, 0, 0, 0.16);\n  max-height: 0;\n  overflow: hidden;\n  padding-bottom: 0;\n  transition: 0.5s;\n}\n\n.modal-busca.active {\n  max-height: 100vh;\n}\n\n.modal-busca .background-busca {\n  display: flex;\n  width: 100%;\n}\n\n.modal-busca .background-busca-mobile {\n  display: none;\n  height: 100%;\n}\n\n.modal-busca .modal-content-busca {\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-direction: column;\n  flex-direction: column;\n  height: auto;\n  left: 0;\n  margin-left: 0;\n  margin-top: 0;\n  position: absolute;\n  top: 0;\n  width: 100%;\n  padding-bottom: 40px;\n}\n\n.modal-busca .modal-content-busca header {\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-pack: end;\n  justify-content: flex-end;\n  padding: 40px 56px 0;\n}\n\n.modal-busca .icon-close {\n  display: inline-block;\n  height: 16px;\n  position: relative;\n  width: 16px;\n  margin-left: 8px;\n}\n\n.modal-busca .icon-close:before,\n.modal-busca .icon-close:after {\n  position: absolute;\n  left: 8px;\n  content: \" \";\n  height: 17px;\n  width: 1px;\n  background-color: #fff;\n}\n\n.modal-busca .icon-close:before {\n  transform: rotate(45deg);\n}\n\n.icon-close:after {\n  transform: rotate(-45deg);\n}\n\n.modal-busca .modal-content-busca header .voltar-busca p {\n  font-family: \"Bradesco\", sans-serif;\n  font-display: swap;\n  font-weight: 500;\n  font-size: 14px;\n  line-height: 18px;\n  color: #ffffff;\n  margin-bottom: 0 !important;\n}\n\n.modal-busca .modal-content-busca .info-content-search {\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-direction: column;\n  flex-direction: column;\n  -ms-flex-pack: justify;\n  justify-content: space-between;\n}\n\n.modal-busca .modal-content-busca .info-content-search .info-content {\n  padding: 0 56px;\n}\n\n.modal-busca form {\n  margin: 0;\n}\n\n.modal-busca .modal-content-busca .input-search-container {\n  margin-top: 64px;\n  width: 100%;\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-pack: justify;\n  justify-content: space-between;\n  -ms-flex-align: center;\n  align-items: center;\n  border-bottom: 1px solid #ffffff;\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search {\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-align: center;\n  align-items: center;\n  width: 80%;\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search .input {\n  width: 100%;\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search input {\n  background: none;\n  width: 100%;\n  border: none;\n  color: #ffffff;\n  font-family: inherit;\n  font-display: swap;\n  font-size: 20px;\n  line-height: 18px;\n  font-weight: 500;\n  margin: 0 16px;\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search input:-webkit-autofill,\n.modal-busca .modal-content-busca .input-search-container .input-search input:-webkit-autofill:hover,\n.modal-busca .modal-content-busca .input-search-container .input-search input:-webkit-autofill:focus,\n.modal-busca .modal-content-busca .input-search-container .input-search textarea:-webkit-autofill,\n.modal-busca .modal-content-busca .input-search-container .input-search textarea:-webkit-autofill:hover,\n.modal-busca .modal-content-busca .input-search-container .input-search textarea:-webkit-autofill:focus,\n.modal-busca .modal-content-busca .input-search-container .input-search select:-webkit-autofill,\n.modal-busca .modal-content-busca .input-search-container .input-search select:-webkit-autofill:hover,\n.modal-busca .modal-content-busca .input-search-container .input-search select:-webkit-autofill:focus {\n  -webkit-box-shadow: 0 0 0px 1000px #ffffff00 inset;\n  -webkit-text-fill-color: #FFFFFF;\n  transition: background-color 5000s ease-in-out 0s;\n}\n\n.none {\n  display: none !important;\n}\n\n.modal-busca img {\n  vertical-align: middle;\n}\n\n.modal-busca .modal-content-busca .input-search-container .icon {\n  margin-left: auto;\n  margin-right: 20px;\n  margin-top: -10px;\n  width: 20px;\n  height: 20px;\n  cursor: pointer;\n}\n\n.modal-busca .modal-content-busca .input-search-container button {\n  height: 40px;\n  width: 40px;\n  border-radius: 20px;\n  margin-bottom: 8px;\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-pack: center;\n  justify-content: center;\n  -ms-flex-align: center;\n  align-items: center;\n}\n\n.modal-busca .modal-content-busca .input-search-container button.voice-button,\n.modal-busca .modal-content-busca .input-search-container button.search-button {\n  background-color: rgba(255, 255, 255, 0.2);\n  border: none;\n  transition: all 0.2s ease-in-out;\n  -moz-transition: all 0.2s ease-in-out;\n  -webkit-transition: all 0.2s ease-in-out;\n  cursor: pointer;\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search input:-ms-input-placeholder {\n  color: #ffffff;\n  opacity: 1;\n  /* Firefox */\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search input::placeholder {\n  color: #ffffff;\n  opacity: 1;\n  /* Firefox */\n}\n\n.modal-busca .modal-content-busca .input-search-container .input-search input:-ms-input-placeholder {\n  /* IE 10-11 */\n  color: #ffffff;\n}\n\n.modal-busca .modal-content-busca .buscas {\n  margin-top: 56px;\n  width: 100%;\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-wrap: wrap;\n  flex-wrap: wrap;\n}\n\n.modal-busca .modal-content-busca .buscas div {\n  width: calc(50% - 24px);\n}\n\n.modal-busca .modal-content-busca .buscas .mais-buscados {\n  margin-right: 48px;\n  min-height: 100px;\n  max-height: 200px;\n}\n\n.modal-busca .modal-content-busca .buscas div h1 {\n  font-size: 24px;\n  font-weight: 700;\n  line-height: 16px;\n  margin: 1em 0;\n  color: #ffffff;\n}\n\n.modal-busca .modal-content-busca .buscas div .infos {\n  margin-top: 24px;\n  font-size: 16px;\n  font-weight: 500;\n  line-height: 16px;\n  color: #ffffff;\n}\n\n.modal-busca .modal-content-busca .buscas div .infos ul {\n  max-height: 160px;\n  overflow-x: auto;\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n.modal-busca .modal-content-busca .buscas div .infos ul li {\n  padding: 8px 0;\n  cursor: pointer;\n  transition: all 0.2s ease-in-out;\n  -moz-transition: all 0.2s ease-in-out;\n  -webkit-transition: all 0.2s ease-in-out;\n}\n\n.modal-busca .modal-content-busca .voice-container {\n  height: 88px;\n  margin-top: 136px;\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-pack: center;\n  justify-content: center;\n  -ms-flex-align: center;\n  align-items: center;\n  transition: all 0.2s ease-in-out;\n  -webkit-transition: all 0.2s ease-in-out;\n  -moz-transition: all 0.2s ease-in-out;\n  user-select: none;\n  -webkit-user-select: none;\n  -ms-user-select: none;\n  -moz-user-select: none;\n}\n\n.modal-busca .modal-content-busca .voice-container .voice-button {\n  border: none;\n  background-color: #ffffff;\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-align: center;\n  align-items: center;\n  -ms-flex-pack: center;\n  justify-content: center;\n  width: 64px;\n  height: 64px;\n  border-radius: 32px;\n}\n\n.modal-busca .modal-content-busca .voice-container .voice-button .icon {\n  height: 64px;\n  width: 64px;\n  background-color: #ffffff;\n  border-radius: 32px;\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-align: center;\n  align-items: center;\n  -ms-flex-pack: center;\n  justify-content: center;\n}\n\n.modal-busca .modal-content-busca .voice-container p {\n  font-size: 24px;\n  line-height: 16px;\n  color: #ffffff;\n  font-weight: 700;\n  margin-left: 32px;\n}\n\n.modal-busca .modal-content-busca .info-content-search .interesse-container {\n  padding: 25px 0 0 56px;\n  margin-top: 24px;\n}\n\n.modal-busca .modal-content-busca .info-content-search .para-voce-container {\n  padding: 25px 0 0 56px;\n  margin-top: 24px;\n}\n\n.modal-busca .modal-content-busca .para-voce-container h1,\n.modal-busca .modal-content-busca .interesse-container h3 {\n  font-size: 24px;\n  font-weight: 700;\n  color: #ffffff;\n  margin-bottom: 16px;\n}\n\n.modal-busca .modal-content-busca .para-voce,\n.modal-busca .modal-content-busca .interesse {\n  overflow: hidden;\n  overflow-x: auto;\n  -ms-overflow-style: none;\n  scrollbar-width: none;\n}\n\n.modal-busca .modal-content-busca .para-voce a,\n.modal-busca .modal-content-busca .interesse a {\n  text-decoration: none;\n}\n\n.modal-busca .modal-content-busca .para-voce .item-container,\n.modal-busca .modal-content-busca .interesse .item-container {\n  display: -ms-inline-flexbox;\n  display: inline-flex;\n  width: 1600px;\n  height: 180px;\n  -ms-flex-align: start;\n  align-items: flex-start;\n  gap: 16px;\n}\n\n.modal-busca .modal-content-busca .para-voce .item,\n.modal-busca .modal-content-busca .interesse .item {\n  height: 176px;\n  width: 290px;\n  border-radius: 5px;\n  box-shadow: 0 3px 6px rgba(0, 0, 0, 0.16);\n  display: -ms-flexbox;\n  display: flex;\n  -ms-flex-align: end;\n  align-items: flex-end;\n  user-select: none;\n  -moz-user-select: none;\n  -ms-user-select: none;\n  -webkit-user-select: none;\n  transition: all 0.2s ease-in-out;\n  -moz-transition: all 0.2s ease-in-out;\n  -webkit-transition: all 0.2s ease-in-out;\n  background-size: cover;\n  overflow: hidden;\n}\n\n.modal-busca .modal-content-busca .para-voce .item img,\n.modal-busca .modal-content-busca .interesse .item img {\n  height: 100%;\n  width: 100%;\n}\n\n.modal-busca .modal-content-busca .para-voce .item a,\n.modal-busca .modal-content-busca .interesse .item a {\n  width: 100%;\n  height: 100%;\n  position: absolute;\n  display: flex;\n  align-items: end;\n}\n\n.modal-busca .modal-content-busca .para-voce .item,\n.modal-busca .modal-content-busca .interesse .item {\n  display: flex;\n  justify-content: center;\n  position: relative;\n}\n\n.modal-busca.theme-classic .modal-content-busca .pa