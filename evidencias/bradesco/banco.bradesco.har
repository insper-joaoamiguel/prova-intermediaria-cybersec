            "text": "{\n  \"sites\": [\n    {\n      \"letter\": \"a\",\n      \"links\": [\n        {\n          \"url\": \"https://www.agorainvestimentos.com.br/\",\n          \"title\": \"Ir para: Ágora Investimentos\",\n          \"text\": \"Ágora Investimentos\"\n        },\n        {\n          \"url\": \"https://banco.bradesco/html/classic/produtos-servicos/emprestimo-e-financiamento/agronegocio/index.shtm\",\n          \"title\": \"Ir para: Agronegócio\",\n          \"text\": \"Agronegócio\"\n        },\n        {\n          \"url\": \"https://autoline.com.br/\",\n          \"title\": \"Ir para: Autoline\",\n          \"text\": \"Autoline\"\n        }\n      ]\n    },\n    {\n      \"letter\": \"b\",\n      \"links\": [\n        {\n          \"url\": \"https://bradescobbi.com.br\",\n          \"title\": \"Ir para: BBI\",\n          \"text\": \"BBI\"\n        },\n        {\n          \"url\": \"https://bemdtvm.bradesco/html/bemdtvm/index.shtm\",\n          \"title\": \"Ir para: BEM DTVM\",\n          \"text\": \"BEM DTVM\"\n        },\n        {\n          \"url\": \"https://www.bradescard.com.br\",\n          \"title\": \"Ir para: Bradescard\",\n          \"text\": \"Bradescard\"\n        },\n        {\n          \"url\": \"https://bradespar.bradesco/\",\n          \"title\": \"Ir para: Bradespar\",\n          \"text\": \"Bradespar\"\n        },\n        {\n          \"url\": \"https://bradescoasset.com.br/pt\",\n          \"title\": \"Ir para: BRAM - Bradesco Asset Management\",\n          \"text\": \"BRAM - Bradesco Asset Management\"\n        }\n      ]\n    },\n    {\n      \"letter\": \"c\",\n      \"links\": [\n        {\n          \"url\": \"https://custodia.bradesco\",\n          \"title\": \"Ir para: Custódia\",\n          \"text\": \"Custódia\"\n        },\n        {\n          \"url\": \"https://cultura.bradesco/\",\n          \"title\": \"Ir para: Cultura Bradesco\",\n          \"text\": \"Cultura Bradesco\"\n        }\n      ]\n    },\n    {\n  