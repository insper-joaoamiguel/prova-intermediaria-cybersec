            "text": "nav#MainMenuMobile.mega-menu {\n  background-color: #f0f1f5;\n  border-left: 0;\n  display: block;\n  left: 100%;\n  right: auto;\n  top: 120px !important;\n  -webkit-transition: 0.5s;\n  transition: 0.5s;\n  z-index: 999;\n}\n\na.botaoAbraConta {\n  cursor: pointer;\n  left: 0;\n  font-family: \"Bradesco\", sans-serif;\n  font-display: swap;\n  letter-spacing: 0.6px;\n  padding-left: 20px;\n  padding-right: 40px;\n  filter: none;\n  bottom: unset;\n  border: none;\n  height: 54px;\n  line-height: 54px;\n  background: #cc092f;\n  text-align: center;\n  color: #fff;\n  font-weight: 700;\n  text-decoration: none;\n  text-transform: uppercase;\n  font-size: 12px;\n  float: none;\n  clear: both;\n  position: relative;\n  display: block;\n  width: 100% !important;\n}\n\n.botaoContrate {\n  top: auto;\n  -webkit-filter: none;\n  height: 56px !important;\n  text-align: center;\n  color: #fff;\n  text-decoration: none;\n  text-transform: uppercase;\n  left: 0;\n  background: #333B8F;\n  border: none;\n  font-family: \"Bradesco\", sans-serif;\n  font-display: swap;\n  font-weight: bold;\n  letter-spacing: 0.6px;\n  font-size: 12px;\n  padding-left: 20px;\n  padding-right: 40px;\n  position: relative;\n  line-height: 54px;\n  float: left;\n  clear: left;\n  filter: none;\n  bottom: initial;\n  width: 100% !important;\n}\n\n.botaoContrate:after,\n.botaoAbraConta:after {\n  content: \"\";\n  background: url(\"data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' width='25' height='25' viewBox='0 0 200 200'%3e%3ccircle fill='none' stroke='white' stroke-width='15' opacity='0.3' cx='100.5' cy='97.5' r='89.5'/%3e%3cpath fill='white' d='M85.633,112.337l24.692-21.4a7.763,7.763,0,0,1,9.878,0,5.506,5.506,0,0,1,0,8.567l-24.693,21.4a7.759,7.759,0,0,1-9.876,0A5.507,5.507,0,0,1,85.633,112.337Z'/%3e%3cpath fill='white' d='M85.633,76.984l24.692,21.41a7.762,7.762,0,0,0,9.878,0,5.506,5.506,0,0,0,0-8.567L95.51,68.413a7.782,7.782,0,0,0-9.876,0A5.509,5.509,0,0,0,85.633,76.984Z'/%3e%3c/svg%3e\") center center no-repeat;\n  display: block;\n  height: 32px;\n  width: 32px;\n  position: absolute;\n  top: 10px;\n  right: 10px;\n  left: auto;\n}\n\n.mm-panel {\n  -webkit-transition: -webkit-transform 0.4s ease;\n  -moz-transition: -moz-transform 0.4s ease;\n  -ms-transition: -ms-transform 0.4s ease;\n  -o-transition: -o-transform 0.4s ease;\n  transition: transform 0.4s ease;\n  -webkit-transform: translate3d(100%, 0, 0);\n  -moz-transform: translate3d(100%, 0, 0);\n  -ms-transform: translate3d(100%, 0, 0);\n  -o-transform: translate3d(100%, 0, 0);\n  transform: translate3d(100%, 0, 0);\n}\n\n.mm-panel.mm-opened {\n  -webkit-transform: translate3d(0%, 0, 0);\n  -moz-transform: translate3d(0%, 0, 0);\n  -ms-transform: translate3d(0%, 0, 0);\n  -o-transform: translate3d(0%, 0, 0);\n  transform: translate3d(0%, 0, 0);\n}\n\na.botaoAbraConta:hover {\n  background: #d63a59;\n}\n\na.botaoContrate:hover {\n  background: #4059a6;\n}\n\n.mm-navbar {\n  border-bottom: 1px solid;\n  border-color: inherit;\n  text-align: center;\n  line-height: 20px;\n  height: 40px;\n  padding: 0 40px;\n  margin: 0;\n  position: absolute;\n  top: 0;\n  left: 0;\n  right: 0;\n}\n\n.mm-navbar>* {\n  display: block;\n  padding: 10px 0;\n}\n\n.mm-navbar .mm-title {\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  overflow: hidden;\n}\n\n.mm-listview,\n.mm-listview>li {\n  list-style: none;\n  display: block;\n  padding: 0;\n  margin: 0;\n}\n\n.mm-listview {\n  font: inherit;\n  font-size: 14px;\n  line-height: 20px;\n}\n\n.mm-listview>li {\n  position: relative;\n}\n\n.mm-listview>li,\n.mm-listview>li:after,\n.mm-listview>li .mm-next,\n.mm-listview>li .mm-next:before {\n  border-color: inherit;\n}\n\n.mm-listview .mm-next {\n  background: rgba(3, 2, 1, 0);\n  width: 50px;\n  padding: 0;\n  position: absolute;\n  right: 0;\n  top: 0;\n  bottom: 0;\n  z-index: 2;\n}\n\n.mm-listview>li,\n.mm-listview>li:after,\n.mm-listview>li .mm-next,\n.mm-listview>li .mm-next:before {\n  border-color: inherit;\n}\n\n.mm-listview a,\n.mm-listview a:hover {\n  text-decoration: none;\n}\n\n.mm-listview>li>a,\n.mm-listview>li>span {\n  overflow: hidden;\n  color: inherit;\n  display: block;\n  margin: 0;\n}\n\n.mm-hidden {\n  display: none !important;\n}\n\nnav#MainMenuMobile .botaoAbraConta,\nnav#MainMenuMobile .botaoContrate {\n  width: 100% !important;\n}\n\nh1.gradient {\n  font-size: 2em;\n  margin: 0.67em 0;\n}\n\nh1.gradient img {\n  width: 100%;\n  height: auto;\n}\n\ndiv.holderFixed {\n  width: 100%;\n  position: fixed;\n  top: 45px;\n  left: 0;\n  display: none;\n  z-index: 9999;\n}\n\nheader.headerMobile {\n  width: 1280px;\n  background: #cc092f;\n  background: linear-gradient(45deg, #b41a83 0%, #cc092f 49%, #f36279 100%);\n  filter: progid:DXImageTransform.Microsoft.gradient(startColorstr='#b41a83', endColorstr='#f36279', GradientType=1);\n  height: 80px;\n  -webkit-box-sizing: border-box;\n  box-sizing: border-box;\n  padding: 20px 0 20px 20px;\n  margin: 0 auto;\n  position: relative;\n  display: none;\n}\n\nheader.headerMobile a.lg-bra {\n  display: table;\n  margin-top: 2px;\n}\n\nheader.headerMobile a.lg-bra img {\n  width: 100%;\n  height: auto;\n}\n\nheader.headerMobile a.buscaMobile {\n  display: none;\n  position: absolute;\n  width: 35px;\n  height: 40px;\n  overflow: hidden;\n  text-indent: -1000px;\n}\n\nheader.headerMobile a.mobileMenu {\n  position: absolute;\n  top: 19px;\n  right: 20px;\n  width: 32px;\n  height: 40px;\n  outline: none;\n  display: flex;\n  overflow: hidden;\n  align-items: start;\n}\n\nheader.headerMobile a.mobileMenu img {\n  height: 100%;\n  object-fit: cover;\n  object-position: top;\n}\n\nheader.headerMobile a.mobileMenu.close img {\n  object-position: bottom;\n}\n\n.MainMenuMobile .mobile-item {\n  display: none;\n}\n\n.MainMenuMobile .items-menu {\n  padding: 0px 20px 0;\n  overflow: scroll;\n  overflow-x: hidden;\n  overflow-y: auto;\n  max-height: calc(100vh - 230px);\n}\n\n.MainMenuMobile .items-menu .item-menu {\n  display: flex;\n  cursor: pointer;\n  border-bottom: 1px solid rgba(0, 0, 0, 0.1);\n  flex-direction: column;\n}\n\nnav#MainMenuMobile.mega-menu .items-menu li a.next-produtos-servicos {\n  background: 0 0;\n  color: #6d6e71;\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 20px;\n  padding: 16px;\n  max-height: 54px;\n  margin-left: auto;\n}\n\nnav#MainMenuMobile.mega-menu .items-menu .item-menu-content {\n  width: 100%;\n  padding: 16px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: #6d6e71;\n  font-size: 14px;\n  font-weight: 500;\n  line-height: 20px;\n}\n\n.mm-next:after {\n  content: \"\";\n  border: 1px solid #e1173f;\n  display: inline-block;\n  width: 8px;\n  height: 8px;\n  -webkit-transform: rotate(-45deg);\n  -moz-transform: rotate(-45deg);\n  -ms-transform: rotate(-45deg);\n  -o-transform: rotate(-45deg);\n  transform: rotate(-45deg);\n  border-top: none;\n  border-left: none;\n  -webkit-transform: rotate(45deg);\n  transform: rotate(45deg);\n}\n\n.menulist-produtos li a::before {\n  content: \"\";\n  background-color: transparent;\n  background-repeat: no-repeat;\n  background-size: contain;\n  width: 30px;\n  height: 26px;\n  display: block;\n  display: inline-block;\n  content: \"\";\n  left: 10px;\n  position: absolute;\n  top: 50%;\n  -webkit-transform: translateY(-50%);\n  transform: translateY(-50%);\n}\n\n.menulist-canais li a::before {\n  content: \"\";\n  background-color: transparent;\n  background-repeat: no-repeat;\n  background-size: contain;\n  height: 30px;\n  width: 46px;\n  display: block;\n  display: inline-block;\n  position: absolute;\n  top: 35%;\n  -webkit-transform: translateY(-50%);\n  transform: translateY(-50%);\n}\n\n.menulist-produtos li.capitalizacao1 a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/capitalizacao.svg\");\n}\n\n.menulist-produtos li.cambio a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/cambio.svg\");\n}\n\n.menulist-produtos li.cartoes1 a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/cartoes.svg\");\n}\n\n.menulist-produtos li.tarifas a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/cesta.svg\");\n}\n\n.menulist-produtos li.consorcios1 a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/consorcio.svg\");\n}\n\n.menulist-produtos li.emprestimo-e-financiamento a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/emprestimo.svg\");\n}\n\n.menulist-produtos li.investimentos1 a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/investimento.svg\");\n}\n\n.menulist-produtos li.leiloes-de-imoveis a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/leiloes.svg\");\n}\n\n.menulist-produtos li.renegociacao-de-dividas a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/renegociacao.svg\");\n}\n\n.menulist-produtos li.seguros1 a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/seguros.svg\");\n}\n\n.menulist-produtos li.tipos-de-conta a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/tipo-de-conta.svg\");\n}\n\n.menulist-produtos li.vida-e-previdencia a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/vida-previdencia.svg\");\n}\n\n.menulist-produtos li.mais-produtos-servicos a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/servicos.svg\");\n}\n\n.mega-menu-canais {\n  background-color: #ffffff;\n  border-radius: 0px 4px 4px 0px;\n  display: flex;\n  width: 491px;\n  height: 27.1rem;\n  position: absolute;\n  top: 4px;\n  right: 1px;\n  padding: 8px;\n  opacity: 1;\n  align-content: center;\n  z-index: 9;\n}\n\n.menulist-canais {\n  display: grid;\n  grid-template-columns: repeat(2, 1fr);\n  grid-template-rows: repeat(2, 1fr);\n  grid-column-gap: 0px;\n  grid-row-gap: 0px;\n}\n\n.menulist-canais li {\n  padding: 8px;\n  -webkit-transform: translateY(0);\n  transform: translateY(0);\n  -ms-flex-preferred-size: 25%;\n  flex-basis: 25%;\n  width: 25%;\n  padding: 10px !important;\n  transition: 0.5s !important;\n  left: 0;\n}\n\n.menulist-canais li a {\n  -webkit-box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.16);\n  box-shadow: 0px 3px 6px rgba(0, 0, 0, 0.16);\n  border-left: 0;\n  border-radius: 4px;\n  color: #a7a8ac !important;\n  display: -webkit-box;\n  display: -ms-flexbox;\n  display: flex !important;\n  -webkit-box-orient: vertical;\n  -webkit-box-direction: normal;\n  -ms-flex-direction: column-reverse;\n  flex-direction: column-reverse !important;\n  -ms-flex-wrap: wrap;\n  flex-wrap: wrap;\n  font-size: 12px;\n  font-weight: 500;\n  letter-spacing: -0.18px;\n  line-height: 16px;\n  -webkit-transition: 0.5s;\n  transition: 0.5s;\n  width: 100% !important;\n  min-width: 105px;\n  align-content: center;\n  align-items: center;\n  height: 125px;\n  text-align: center;\n  /* padding: 10px 8px 15px 10px !important; */\n}\n\n.menulist-canais li.fale-com-a-bia,\n.menulist-canais li.whatsapp {\n  flex-basis: 50%;\n}\n\n.fale-com-a-bia a {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/fale-com-a-bia.png\");\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: 280px 155px;\n}\n\n.whatsapp a {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/whatsapp.png\");\n  background-image: -webkit-image-set(url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/whatsapp.png\") 1x);\n  background-position: center;\n  background-repeat: no-repeat;\n  background-size: 280px 155px;\n}\n\n.whatsapp a:after,\n.fale-com-a-bia a:after {\n  background: -webkit-gradient(linear,\n      left top,\n      left bottom,\n      from(#47484c),\n      to(#47484c));\n  background: linear-gradient(180deg, #47484c 0%, #47484c 100%);\n  content: \"\";\n  height: 100%;\n  left: 0;\n  opacity: 0.6;\n  position: absolute;\n  top: 0;\n  -webkit-transition: 0.3s;\n  transition: 0.3s;\n  width: 100%;\n  z-index: 1;\n}\n\n.menulist-canais li.fale-com-a-bia a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/bia-hover.svg\");\n  height: 33px;\n  width: 21px;\n  z-index: 2;\n}\n\n.fale-com-a-bia a span,\n.whatsapp a span {\n  color: #fff;\n  z-index: 2;\n  position: absolute;\n  bottom: 35px;\n}\n\n.menulist-canais li.whatsapp a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/whatsapp.svg\");\n  height: 39px;\n  width: 39px;\n  z-index: 2;\n}\n\n.menulist-canais li.como-usar-bradesco a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/como-usar.svg\");\n  height: 30px;\n  width: 30px;\n  top: 50%;\n  left: 10px\n}\n\n.menulist-canais li.internet-banking a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/internet-banking.svg\");\n  top: 60%;\n  left: 10px;\n  width: 35px;\n}\n\n.menulist-canais li.aplicativos-bradesco a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/app-bradesco.svg\");\n  left: 18px;\n  top: 50%;\n  height: 36px;\n  width: 35px;\n}\n\n.menulist-canais li.autoatendimento a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/caixa-eletronico.svg\");\n  left: 12px;\n  top: 23px;\n  height: 30px;\n  width: 30px;\n}\n\n.menulist-canais li.bia a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/bia.svg\");\n  left: 12px;\n  top: 24px;\n  height: 30px;\n  width: 30px;\n}\n\n.menulist-canais li.bia:hover a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/bia-hover.svg\");\n  left: 12px;\n  top: 24px;\n  height: 30px;\n  width: 30px;\n}\n\n\n.menulist-canais li.fale-com-a-bia a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/bia-hover.svg\");\n  height: 33px;\n  width: 21px;\n  z-index: 2;\n}\n\n.menulist-canais li.whatsapp a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/whatsapp.svg\");\n  height: 39px;\n  width: 39px;\n  z-index: 2;\n}\n\n.menulist-canais li.fone-facil a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/fone-facil.svg\");\n  height: 26px;\n  width: 26px;\n}\n\n.menulist-canais li.podcast a::before {\n  height: 20px;\n  width: 20px;\n}\n\n.menulist-canais li.bradesco-explica a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/bradesco-explica.svg\");\n  height: 22px;\n  width: 34px;\n}\n\n.menulist-canais li.horarios-limites a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/horarios-limites.svg\");\n  height: 20px;\n  width: 20px;\n}\n\n.menulist-canais li.horarios-limites a,\n.menulist-canais li.podcast a {\n  top: -0.7rem;\n}\n\nh1.gradient::before,\n.menulist-canais li.podcast a::before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/common/img/icons/home/icon-podcast-cinza.png\");\n}\n\n/* icon-podcast-branco */\n.menulist-canais li.podcast a:hover:before {\n  background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/common/img/icons/home/icon-podcast-branco.png\");\n}\n\n.menulist-canais::before {\n  content: none !important;\n}\n\n@media screen and (min-width: 1025px) {\n  nav#MainMenuMobile {\n    position: absolute !important;\n    background-color: transparent !important;\n    display: flex !important;\n    flex-direction: column !important;\n    flex-wrap: nowrap !important;\n    align-content: center !important;\n    align-items: flex-start !important;\n    justify-content: flex-end !important;\n    border-left: 0px !important;\n    width: 188px !important;\n    height: 387px;\n    margin: 0 60px !important;\n    float: left !important;\n    left: 0px !important;\n  }\n\n  nav#MainMenuMobile .botaoAbraConta {\n    display: block !important;\n    width: 188px !important;\n  }\n\n  a.botaoContrate {\n    z-index: 1;\n    width: fit-content !important;\n    height: fit-content !important;\n    font-size: 12px !important;\n  }\n\n  div#mm-1 {\n    width: 188px;\n    height: auto;\n    background-color: #ffffff;\n    padding-left: 10px;\n    padding-bottom: 5px;\n    position: relative;\n  }\n\n  .mm-navbar {\n    display: none !important;\n  }\n\n  #menu-lateral {\n    position: relative;\n  }\n\n  .mm-listview li {\n    width: 190px;\n    min-height: 45px;\n    left: -10px;\n  }\n\n  nav#MainMenuMobile ul li:before {\n    content: \"\";\n    display: block;\n    height: 1px;\n    width: 110px;\n    background: #eee;\n    margin: 0 auto;\n  }\n\n  [data-target=\"#mm-2\"] {\n    display: none !important;\n  }\n\n  .mm-next {\n    opacity: 0 !important;\n    width: 100% !important;\n  }\n\n  .next-produtos-servicos {\n    cursor: pointer;\n  }\n\n  .mm-next~a {\n    position: absolute;\n    top: 0px;\n  }\n\n  .mm-listview>li>a,\n  .mm-listview>li>span {\n    padding: 11px 20px 11px 58px !important;\n  }\n\n  .mm-listview .mm-next+a,\n  .mm-listview .mm-next+span {\n    margin-right: 0px !important;\n  }\n\n  .mm-listview li a:not(.mm-next) {\n    -ms-flex-line-pack: center;\n    align-content: center;\n    -webkit-box-align: center;\n    -ms-flex-align: center;\n    align-items: center;\n    display: -webkit-box !important;\n    display: -ms-flexbox !important;\n    display: flex !important;\n    -ms-flex-wrap: wrap;\n    flex-wrap: wrap;\n    -webkit-box-orient: horizontal;\n    -webkit-box-direction: normal;\n    -ms-flex-direction: row;\n    flex-direction: row;\n    -webkit-box-pack: start;\n    -ms-flex-pack: start;\n    justify-content: flex-start;\n    margin-left: 0;\n    padding-left: 59px;\n    position: relative;\n  }\n\n  nav#MainMenuMobile ul li a {\n    color: #222222;\n  }\n\n  .menu-lateral li a:not(.mm-next):before {\n    content: \"\";\n    background-color: transparent;\n    background-repeat: no-repeat;\n    background-size: contain;\n    width: 29px;\n    height: 28px;\n    display: inline-block;\n    position: absolute;\n    left: 20px;\n  }\n\n  .menu-lateral li.produtos-servicos a::before {\n    background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/icon-produtos-servicos.svg\");\n  }\n\n  .menu-lateral li.produtos-servicos:hover a::before {\n    background-image: url(\"https://assets.bradesco/content/dam/portal-bradesco/assets/classic/home/images/mega-menu/icon-produtos-servicos-red.svg\");\n  }\n\n  .menu-lateral l