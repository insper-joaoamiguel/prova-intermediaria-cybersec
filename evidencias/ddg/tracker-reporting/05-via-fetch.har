            "mimeType": "text/html; charset=UTF-8",
            "size": 476,
            "text": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width\">\n  <title>Tracker loaded via fetch</title>\n\n  <script src=\"./utils.js\"></script>\n  <script>\n// eslint-disable-next-line no-unused-vars\nfunction init () {\n    callAfterDelay(loadTracker);\n}\n\nfunction loadTracker () {\n    const targetElement = document.getElementById('target-div');\n\n    fetch('https://facebook.com/tr?test=1', { mode: 'no-cors' })\n        .then(resp => {\n            targetElement.innerText = 'Tracker loaded';\n        })\n        // eslint-disable-next-line node/handle-callback-err\n        .catch(err => {\n            targetElement.innerText = 'Tracker not loaded';\n        });\n}\n  </script>\n\n</head>\n<body onload=\"init()\">\n<p><a href=\"../index.html\">[Home]</a></p>\n\n<p>Tracker loaded via fetch</p>\n\n<div id=\"target-div\">\n</div>\n\n</body>\n</html>\n"
          },
